{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "firebase emulators:exec --project questkids-mobile --config ../firebase.json --only firestore,storage \"jest\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/text-to-speech": "^7.1.1",
    "@google/generative-ai": "^0.24.1",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "babel-jest": "^30.5.2",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.33.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@google-cloud/storage": "^8.0.1",
    "gaxios": "^7.3.1"
  },
  "private": true
}
